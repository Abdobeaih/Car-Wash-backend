{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "serverless.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "serverless.ts"
    }
  ],
  "crons": [
    {
      "path": "/internal/plan-reminders",
      "schedule": "0 7 * * *"
    }
  ]
}
