# Backend environment — copy to .env
# NOTE: For deployment (e.g. Vercel), do NOT rely on this file. Set the same
# variables in your hosting provider's environment instead — production ignores
# this .env file entirely and fails fast if DATABASE_URL is missing.
PORT=3001
DATABASE_URL=mongodb://127.0.0.1:27017/mobile-car-care
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000

# Email (Gmail SMTP) — used for OTP verification and password reset codes.
# SMTP_PASS must be an App Password for the Gmail account
# (Google Account > Security > App passwords); your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=Mobile Car Care <your-smtp-user@gmail.com>

# Local development only: when SMTP delivery fails, log the OTP to the server
# console instead of failing the request. Never set this in production.
SMTP_LOG_OTP=false

# SMS (Twilio) — used for OTP verification codes sent by text message.
# Get these from the Twilio Console (https://console.twilio.com).
# TWILIO_FROM_NUMBER must include the country code, e.g. +14155550000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Seed credentials (development only)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=your-admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_CUSTOMER_NAME=Demo Customer
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=CustomerPass123!